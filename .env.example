# Xboard panel root URL, including any path prefix. HTTPS is required by default.
XBOARD_URL=https://panel.example.com
XBOARD_TOKEN=
XBOARD_NODE_ID=1

# Official Xray-core v26.11.9. Set an absolute path if it is outside PATH.
XRAY_BIN=xray
XRAY_LISTEN=0.0.0.0
XRAY_API_PORT=10085
STATE_DIR=./state

# For a TLS node, set both paths. Leave empty for REALITY.
XRAY_CERT_FILE=
XRAY_KEY_FILE=

# Optional. Set to 1 only for local testing with a plaintext panel or node.
ALLOW_HTTP_PANEL=0
ALLOW_PLAINTEXT_NODE=0

# Panel interval values take precedence. Stale cutoff is at least 3 × pull interval.
PULL_INTERVAL=60
PUSH_INTERVAL=60
STALE_AFTER=900
