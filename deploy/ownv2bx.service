[Unit]
Description=ownv2bx Xboard node
Wants=network-online.target
After=network-online.target

[Service]
Type=exec
User=ownv2bx
Group=ownv2bx
WorkingDirectory=/opt/ownv2bx/current
EnvironmentFile=/etc/ownv2bx/node.env
Environment=XRAY_BIN=/opt/ownv2bx/current/xray
Environment=STATE_DIR=/var/lib/ownv2bx
Environment=NODE_LOCK_DIR=/run/ownv2bx
StateDirectory=ownv2bx
StateDirectoryMode=0700
RuntimeDirectory=ownv2bx
RuntimeDirectoryMode=0700
ExecStart=/opt/ownv2bx/current/ownv2bx
Restart=on-failure
RestartSec=5
KillMode=mixed
TimeoutStopSec=60
UMask=0077
NoNewPrivileges=true
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
AmbientCapabilities=CAP_NET_BIND_SERVICE
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true

[Install]
WantedBy=multi-user.target
