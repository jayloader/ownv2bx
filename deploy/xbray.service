[Unit]
Description=xbray Xboard node
Wants=network-online.target
After=network-online.target

[Service]
Type=exec
User=xbray
Group=xbray
WorkingDirectory=/opt/xbray/current
EnvironmentFile=/etc/xbray/node.env
Environment=XRAY_BIN=/opt/xbray/current/xray
Environment=STATE_DIR=/var/lib/xbray
Environment=NODE_LOCK_DIR=/run/xbray
StateDirectory=xbray
StateDirectoryMode=0700
RuntimeDirectory=xbray
RuntimeDirectoryMode=0700
ExecStart=/opt/xbray/current/xbray
Restart=on-failure
RestartSec=5
KillMode=mixed
TimeoutStopSec=60
UMask=0077
NoNewPrivileges=true
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
AmbientCapabilities=CAP_NET_BIND_SERVICE
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true

[Install]
WantedBy=multi-user.target
