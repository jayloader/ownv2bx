# Xboard 面板根地址可包含路径前缀。请填写实际地址、节点通信密钥和节点 ID。
XBOARD_URL=https://panel.example.com
XBOARD_TOKEN=
XBOARD_NODE_ID=1

# VLESS 节点监听地址。Xray 统计接口仅监听本机并使用独立端口。
XRAY_LISTEN=0.0.0.0
XRAY_API_PORT=10085

# TLS 节点填写证书链和私钥的绝对路径，文件需允许 ownv2bx 服务用户读取。
# REALITY 节点留空。
XRAY_CERT_FILE=
XRAY_KEY_FILE=

# 若面板下发有效推拉间隔，优先使用面板设置。
PULL_INTERVAL=60
PUSH_INTERVAL=60
STALE_AFTER=900
